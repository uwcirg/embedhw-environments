# Example docker-compose environment file
# Copy to fishmouth.env and modify as necessary
# https://docs.docker.com/compose/env-file/

# Variables defined in this file will only be available to containers/images
# ie not for interpolation in docker-compose YAML files

# Respective FHIR server URLs
#   $extract called on APP_FHIR_URL, results persisted to UPSTREAM_FHIR_URL
APP_FHIR_URL=
UPSTREAM_FHIR_URL=

# Basic Auth credentials for UPSTREAM_FHIR
UPSTREAM_FHIR_USER=
UPSTREAM_FHIR_PASSWORD=

# List of extracted resource types to persist to APP_FHIR, in addition
# to default behavior of persisting all extracted to UPSTREAM_FHIR
EXTRACTED_RESOURCES_PERSISTED_IN_APP_FHIR=

# unique to install
SECRET_KEY=
